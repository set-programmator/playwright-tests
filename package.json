{
  "name": "@playwright-tests/boilerplate",
  "version": "1.0.0",
  "description": "A comprehensive Playwright boilerplate for UI and API testing",
  "main": "index.js",
  "scripts": {
    "test:ui": "playwright test tests/ui --reporter=html,allure-playwright",
    "test:api": "playwright test tests/api --reporter=html,allure-playwright",
    "test:mobile": "playwright test --project=mobile --reporter=html,allure-playwright",
    "test:smoke": "playwright test --grep @smoke --reporter=html,allure-playwright",
    "test:regression": "playwright test --grep @regression --reporter=html,allure-playwright",
    "test:modern": "playwright test tests/modern --reporter=html,allure-playwright",
    "test:performance": "playwright test --grep @performance --reporter=html,allure-playwright",
    "test:visual": "playwright test --update-snapshots",
    "test:parallel": "playwright test --workers=4 --reporter=html,allure-playwright",
    "test:headed": "playwright test --headed --reporter=html,allure-playwright",
    "test:debug": "playwright test --debug",
    "test:record": "playwright test --trace=on --video=on --screenshot=on",
    "test:ci": "playwright test --forbid-only --workers=2",
    "test:last-failed": "playwright test --last-failed",
    "test:grep": "playwright test --grep",
    "test:security": "playwright test tests/security --reporter=html,allure-playwright",
    "test:quality": "playwright test tests/quality --reporter=html,allure-playwright",
    "quality:gates": "node scripts/quality-gates.js",
    "quality:check": "npm run quality:gates",
    "report:open": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "report:generate": "allure generate allure-results --clean",
    "setup:install": "playwright install && npm install",
    "setup:interactive": "node scripts/setup.js",
    "setup:env": "node src/utils/setup-env.js",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "format": "prettier --write src tests",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm run security:audit && npm run test:security",
    "performance:lighthouse": "playwright test tests/performance --reporter=html",
    "analytics:report": "node scripts/analytics-report.js",
    "analytics:export": "node scripts/analytics-report.js --export",
    "analytics:cleanup": "node scripts/analytics-report.js --cleanup 30",
    "dev:generate": "node scripts/dev-tools.js generate",
    "dev:page-object": "node scripts/dev-tools.js page-object",
    "dev:test-data": "node scripts/dev-tools.js test-data", 
    "dev:debug": "node scripts/dev-tools.js debug",
    "dev:dashboard": "node scripts/dev-tools.js dashboard",
    "validate:setup": "node scripts/validate-setup.js",
    "validate:smoke": "playwright test tests/smoke/boilerplate-validation.spec.ts --reporter=list",
    "validate:all": "npm run validate:setup && npm run validate:smoke",
    "health-check": "node scripts/health-check.js",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "ui",
    "api",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "ajv": "^8.17.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.0-beta.9",
    "dotenv": "^16.3.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint": "^8.0.0",    "lighthouse-ci": "^0.12.0",
    "nodemailer": "^6.9.0",
    "@types/nodemailer": "^6.4.0",
    "csv-parser": "^3.0.0",
    "zap-api-nodejs": "^0.2.0",    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
